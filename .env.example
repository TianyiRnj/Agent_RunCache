# Default provider used by the CLI when no explicit LLM configuration is given.
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=

# Optional LLM providers used by the corresponding library examples.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Optional remote browser provider. Required only with the --hyperbrowser flag.
HYPERBROWSER_API_KEY=

# Optional integration used by examples/custom-tool/search/exa.ts.
EXA_API_KEY=

# Public demo credentials used by examples/simple/login-to-saucedemo.ts.
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# Optional debug switches. Set a value to 1 to enable it.
# A non-empty AGENT_RUN_CACHE_* value takes precedence. When it is unset or
# empty, the matching legacy HYPERAGENT_* variable is still honored.
AGENT_RUN_CACHE_PROFILE_DOM=
AGENT_RUN_CACHE_TRACE_WAIT=
AGENT_RUN_CACHE_DEBUG_STRUCTURED_SCHEMA=
