{
  "compilerOptions": {
    "target": "es2021",
    "lib": [
      "es2021",
      "DOM"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./dist",
    "paths": {
      "agent-run-cache": [
        "./src/index"
      ],
      "agent-run-cache/types": [
        "./src/types/index"
      ],
      "agent-run-cache/custom-actions": [
        "./src/custom-actions/index"
      ],
      "agent-run-cache/actions": [
        "./src/agent/actions/index"
      ],
      "agent-run-cache/utils": [
        "./src/utils/index"
      ],
      "agent-run-cache/llm/providers": [
        "./src/llm/providers/index"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "debug"
  ]
}